# Supabase (Project Settings > API del NUEVO proyecto de Supabase)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Service role key (Project Settings > API > service_role). SOLO servidor, nunca NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secreto para proteger el endpoint del cron. Genera uno aleatorio (ej: openssl rand -hex 16).
# En Vercel, al existir esta env var, el cron manda "Authorization: Bearer <CRON_SECRET>" solo.
CRON_SECRET=un-secreto-aleatorio
